describe('computeDFT4', () => {
  it('returns (1,1,1,1) for unit impulse (1,0,0,0)', () => {
    const input: Complex[] = [
      { re: 1, im: 0 }, { re: 0, im: 0 },
      { re: 0, im: 0 }, { re: 0, im: 0 }
    ];
    const out = computeDFT4(input);
    for (const z of out) {
      expect(z.re).toBeCloseTo(1, 12);
      expect(z.im).toBeCloseTo(0, 12);
    }
  });
});
\end{verbatim}
\end{minipage} \\
